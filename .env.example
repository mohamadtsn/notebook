# Copy to .env before `docker compose up`.
# The server refuses to boot if JWT_SECRET is missing or shorter than 32 chars.
# Generate one: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-random-characters

# Origin allowed to call the API (the frontend).
CORS_ORIGIN=http://localhost:5173

# Host port for the API.
PORT=3000

# Where the frontend looks for the API. Only VITE_-prefixed vars reach the browser —
# JWT_SECRET above never does.
VITE_API_URL=http://localhost:3000