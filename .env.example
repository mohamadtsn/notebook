# Copy to .env before `docker compose up`.
# The server refuses to boot if JWT_SECRET is missing or shorter than 32 chars.
# Generate one: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-random-characters

# Origin allowed to call the API (the frontend).
CORS_ORIGIN=http://localhost:3237

# Host port for the API.
BACKEND_PORT=3236

# Host port for the APP.
FRONTEND_PORT=3237

# Where the frontend looks for the API. Only VITE_-prefixed vars reach the browser —
# JWT_SECRET above never does.
VITE_API_URL=http://localhost:3236

# The uid/gid the server container runs as. They must match the owner of ./data,
# or SQLite fails with "unable to open database file" (errcode 14).
# Set them to your own — the shell does NOT export UID, and GID does not exist,
# so compose cannot read them from the environment:
#   printf 'UID=%s\nGID=%s\n' "$(id -u)" "$(id -g)" >> .env
UID=1000
GID=1000
# Optional — the server-side AI proxy. Without all three of BASE_URL/API_KEY/MODEL,
# /ai/complete answers 503 and the app tells the user to configure it or switch to
# «مستقیم» mode, where the key stays on their own device.
# The client can never supply any of these: a client-supplied base URL would make the
# endpoint an SSRF gadget.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Per-account requests per day. There is also a fixed 20/minute route limit.
AI_DAILY_LIMIT=300
