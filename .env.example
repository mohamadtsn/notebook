# Copy to .env before `docker compose up`.
# The server refuses to boot if JWT_SECRET is missing or shorter than 32 chars.
# Generate one: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-random-characters

# Origin allowed to call the API (the frontend).
CORS_ORIGIN=http://localhost:3237

# Host port for the API.
BACKEND_PORT=3236

# Host port for the APP.
FRONTEND_PORT=3237

# Where the frontend looks for the API. Only VITE_-prefixed vars reach the browser —
# JWT_SECRET above never does.
VITE_API_URL=http://localhost:3236

# The uid/gid the server container runs as. They must match the owner of ./data,
# or SQLite fails with "unable to open database file" (errcode 14).
# Set them to your own — the shell does NOT export UID, and GID does not exist,
# so compose cannot read them from the environment:
#   printf 'UID=%s\nGID=%s\n' "$(id -u)" "$(id -g)" >> .env
UID=1000
GID=1000