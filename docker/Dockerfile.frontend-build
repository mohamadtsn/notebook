# Builds the frontend into the bind-mounted ./dist.
#
# The build MUST be the container's command, not a RUN layer: ./dist is mounted
# over /app/dist at run time, so whatever a RUN step wrote there during the image
# build is shadowed and never reaches the host.
FROM node:24-alpine
WORKDIR /app

# Cache dependency layer (requires devDependencies for build tools like tsc and vite)
COPY package.json package-lock.json ./
RUN npm ci

# Source files (filtered by .dockerignore)
COPY . .

# Grant write permissions on /app and /app/node_modules so non-root host UID can write build artifacts (.tmp/tsbuildinfo)
RUN chmod 777 /app /app/node_modules

CMD ["npm", "run", "build"]
